{
  "name": "Kubernetes Administradores Lab",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": true,
      "azureDnsAutoDetection": true,
      "disableIp6tables": true
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    }
  },
  "postCreateCommand": "chmod +x scripts/*.sh scripts/*.py && bash scripts/bootstrap-tools.sh",
  "postStartCommand": "bash scripts/kind-net-fix.sh || true",
  "forwardPorts": [8888, 8889, 8080, 8443, 3000, 9090],
  "portsAttributes": {
    "8888": { "label": "M00 Web", "onAutoForward": "notify" },
    "8889": { "label": "M00 API", "onAutoForward": "silent" },
    "8080": { "label": "Ingress HTTP", "onAutoForward": "notify" },
    "8443": { "label": "Ingress HTTPS", "onAutoForward": "silent" },
    "3000": { "label": "Grafana (M07)", "onAutoForward": "silent" },
    "9090": { "label": "Prometheus (M07)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml"
      ]
    }
  }
}
